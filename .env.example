# Azure Integration Configuration
# Copy this file to .env and update with your actual Azure endpoints

# Enable Azure Digital Twins integration
# Set to 'true' to enable, 'false' to disable (default: false)
ENABLE_AZURE_INTEGRATION=true

# Azure Function App endpoint (if using Function App mode)
# Format: https://your-function-app.azurewebsites.net/api/ProcessSimulationTelemetry
AZURE_FUNCTION_ENDPOINT=https://your-function-app.azurewebsites.net/api/ProcessSimulationTelemetry

# Azure Function App key (optional - can be included in endpoint URL with ?code=<key>)
AZURE_FUNCTION_KEY=your-function-key-here

# Azure Digital Twins endpoint (for direct mode or fallback)
# Format: https://your-instance.api.eus.digitaltwins.azure.net
AZURE_DIGITAL_TWINS_ENDPOINT=https://your-instance.api.eus.digitaltwins.azure.net

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Update the endpoints with your actual Azure resource URLs
# 3. Start the API: uvicorn api.main:app --reload
# 4. Verify: ./check_azure_integration.sh
